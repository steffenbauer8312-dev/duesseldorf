{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/leistungen/carport/", "destination": "/leistungen/carportbau/", "permanent": true },
    { "source": "/leistungen/sommerhitze-service/", "destination": "/ratgeber/sommerhitze/", "permanent": true },
    { "source": "/leistungen/aufsparrendämmung/", "destination": "/leistungen/aufsparrendaemmung/", "permanent": true },
    { "source": "/leistungen/zwischensparrendämmung/", "destination": "/leistungen/zwischensparrendaemmung/", "permanent": true },
    { "source": "/leistungen/sparrren-austauschen-oder-verstaerken/", "destination": "/leistungen/sparren-austauschen-oder-verstaerken/", "permanent": true },
    { "source": "/leistungen/altbau-dachausbau/", "destination": "/ratgeber/altbau-dachausbau/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
